---
// UpgradHeader.astro - upGrad Clean White & Crimson Red Header
---

<header class="ug-header-wrap" role="banner">
  <div class="ug-container">
    <div class="ug-header-inner">
      
            <!-- Brand Logo in upGrad Style (Exact 40x40 Box with 8px radius) -->
      <a href="/" class="ug-logo-group" aria-label="OllaVPN Blog Home">
        <div class="ug-logo-icon">
          <!-- Geometric Shield Eagle Icon -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="ug-logo-text-block">
          <div class="ug-brand-name">olla<span>vpn</span></div>
          <span class="ug-brand-badge">RESEARCH BLOG</span>
        </div>
      </a>

      <!-- Header Search Input Bar -->
      <div class="ug-search-wrap" role="search">
        <svg class="ug-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="search" 
          id="ug-nav-search"
          class="ug-search-input" 
          placeholder="Search all 140 technical guides (e.g. WireGuard, Post-Quantum, DNS Leak)..." 
          aria-label="Search articles"
          autocomplete="off"
        />
        <kbd class="ug-search-kbd">/</kbd>
      </div>

      <!-- Nav Menu Links -->
      <nav class="ug-nav-menu" aria-label="Main Navigation">
        <a href="#categories-section" class="ug-nav-link">All Categories</a>
        <a href="#curriculum-section" class="ug-nav-link">Learning Tracks</a>
        <a href="/blog/what-is-a-post-quantum-vpn/" class="ug-nav-link">PQC Standards</a>
        <a href="#support-section" class="ug-nav-link">Dual CCIE Lab</a>
      </nav>

      <!-- Action Button -->
      <div class="ug-header-actions">
        <a href="https://ollavpn.com/apps.html" target="_blank" rel="noopener" class="ug-btn-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Get Free App</span>
        </a>
      </div>

    </div>
  </div>
</header>
