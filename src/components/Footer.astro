---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand-row">
      <a class="brand" href="/" aria-label="OllaVPN Home">
        <img src="/logo.png" alt="OllaVPN Logo" class="footer-logo-img" width="36" height="36" />
        <span class="brand-name footer-brand-name">olla<span style="color:#DA291C;">vpn</span></span>
      </a>
      <p>&copy; {year} {SITE.brand}. All rights reserved.</p>
    </div>
    <p class="footer-links">
      <a href={SITE.marketingUrl}>{SITE.marketingLabel}</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/tags/">Tags</a>
    </p>
  </div>
</footer>
