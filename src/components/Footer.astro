---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
        <div class="footer-brand-row">
      <a class="ug-logo-group" href="/" aria-label="OllaVPN Home">
        <div class="ug-logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="ug-logo-text-block">
          <div class="ug-brand-name" style="color:#0F172A;">olla<span style="color:#DA291C;">vpn</span></div>
          <span class="ug-brand-badge">RESEARCH BLOG</span>
        </div>
      </a>
      <p>&copy; {year} OllaVPN. All rights reserved.</p>
    </div>
    <p class="footer-links">
      <a href={SITE.marketingUrl}>{SITE.marketingLabel}</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/tags/">Tags</a>
    </p>
  </div>
</footer>
