---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
        <div class="footer-brand-row">
      <a class="ug-logo-group" href="/" aria-label="OllaVPN Home">
        <img src="/logo.png" srcset="/logo.png 1x, /logo@2x.png 2x" alt="OllaVPN Logo" width="40" height="40" class="ug-logo-img" style="width: 40px; height: 40px; border-radius: 8px; display: block; flex-shrink: 0;" />
        <div class="ug-logo-text-block">
          <div class="ug-brand-name" style="color:#0F172A;">olla<span style="color:#DA291C;">vpn</span></div>
          <span class="ug-brand-badge">RESEARCH BLOG</span>
        </div>
      </a>
      <p>&copy; {year} OllaVPN. All rights reserved.</p>
    </div>
    <p class="footer-links">
      <a href={SITE.marketingUrl}>{SITE.marketingLabel}</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/rss.xml">RSS</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/tags/">Tags</a>
    </p>
  </div>
</footer>
