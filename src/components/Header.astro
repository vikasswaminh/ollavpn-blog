---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Top Announcement Banner -->
<div class="top-announcement-bar">
  🔒 SPECIAL OFFER: GET 30 DAYS UNLIMITED FREE VPN ACCESS WITH HIGH-SPEED SERVERS
</div>

<!-- Sub Info Bar -->
<div class="sub-info-bar">
  <div class="container sub-info-inner">
    <div class="sub-info-left">
      <span class="sub-info-item">🌐 OLLA-NETWORK GLOBAL</span>
      <span class="sub-info-item">📞 +1 800 555-OLLA</span>
      <span class="sub-info-item">🕒 24/7 SUPPORT AVAILABLE</span>
    </div>
    <div class="sub-info-right">
      <a href="#" class="sub-info-link">PORTAL LOGIN</a>
      <span>•</span>
      <a href="#" class="sub-info-link">SERVER SPEED TEST</a>
      <span>•</span>
      <a href="#" class="sub-info-link">FREE IP CHECKER</a>
      <span>•</span>
      <span class="highlight-text">✦ OLLA ENGINE v2.0 READY →</span>
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-logo-badge">NH</span>
      <div class="brand-name-group">
        <span class="brand-title">{SITE.brand}</span>
        <span class="brand-sub">NETWORKERS HOME</span>
      </div>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
      <a class="btn-contact" href={SITE.marketingUrl}>Get OllaVPN</a>
    </nav>
  </div>
</header>

<!-- Ticker Bar -->
<div class="ticker-bar">
  <div class="container ticker-inner">
    <span class="ticker-item">👤 No-Logs Audit Passed</span>
    <span class="ticker-item"><span class="dot">•</span> ⭐ 4.9★ User Rating (12,500+)</span>
    <span class="ticker-item"><span class="dot">•</span> ⚡ WireGuard & OpenVPN</span>
    <span class="ticker-item"><span class="dot">•</span> 🌐 50+ Server Locations</span>
    <span class="ticker-item"><span class="dot">•</span> 🛡️ Kill Switch Built-in</span>
    <span class="ticker-item"><span class="dot">•</span> 💻 Multi-Device Support</span>
    <span class="ticker-item"><span class="dot">•</span> 🚀 10Gbps Bandwidth</span>
  </div>
</div>

