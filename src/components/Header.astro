        <div class="ug-logo-text-block">
          <div class="ug-brand-name">olla<span>vpn</span></div>
          <span class="ug-brand-badge">RESEARCH BLOG</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="nav nav-center" aria-label="Primary">
      <!-- Technology Dropdown -->
      <div class="nav-item has-dropdown">
        <a href="/tags/protocol-tech/" class="nav-link dropdown-trigger">
          <span>Technology</span>
          <svg class="nav-arrow" width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 10l5 5 5-5z"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/blog/what-is-post-quantum-cryptography/" class="dropdown-link">
            <strong>Post-Quantum Encryption</strong>
            <span>Future-proof NIST-standard lattice security</span>
          </a>
          <a href="/blog/wireguard-vs-openvpn/" class="dropdown-link">
            <strong>WireGuard Protocol</strong>
            <span>Lightweight, high-speed 10Gbps tunneling</span>
          </a>
          <a href="/blog/which-free-vpn-does-not-keep-logs/" class="dropdown-link">
            <strong>Zero-Logs Architecture</strong>
            <span>RAM-only server infrastructure</span>
          </a>
          <a href="/blog/what-is-a-vpn-kill-switch/" class="dropdown-link">
            <strong>Kill Switch Protection</strong>
            <span>Automatic system-level network fallback</span>
          </a>
        </div>
      </div>

      <!-- Blogs Dropdown -->
      <div class="nav-item has-dropdown">
        <a href="/blog/" class="nav-link dropdown-trigger">
          <span>Blogs</span>
          <svg class="nav-arrow" width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 10l5 5 5-5z"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/blog/" class="dropdown-link">
            <strong>All Articles (149)</strong>
            <span>Explore our complete library</span>
          </a>
          <a href="/tags/buyer-guides/" class="dropdown-link">
            <strong>Buyer Guides</strong>
            <span>Device &amp; platform recommendations</span>
          </a>
          <a href="/tags/privacy-security/" class="dropdown-link">
            <strong>Privacy &amp; Security</strong>
            <span>Digital footprint &amp; data defense</span>
          </a>
          <a href="/tags/how-to-guides/" class="dropdown-link">
            <strong>How-To Guides</strong>
            <span>Step-by-step setup &amp; configurations</span>
          </a>
          <a href="/tags/comparisons/" class="dropdown-link">
            <strong>VPN Comparisons</strong>
            <span>In-depth head-to-head performance benchmarks</span>
          </a>
        </div>
      </div>

      <!-- Free VPN -->
      <a href="https://ollavpn.com/free-vpn" class="nav-link">
        <span>Free VPN</span>
      </a>

      <!-- Apps -->
      <a href="https://ollavpn.com/apps.html" class="nav-link">
        <span>Apps</span>
      </a>

      <!-- Download -->
      <a href="https://ollavpn.com/dl/" class="nav-link">
        <span>Download</span>
      </a>
    </nav>

    <div class="header-right">
      <a class="btn-contact" href="https://ollavpn.com/dl/">Get OllaVPN</a>
      <!-- Mobile Hamburger Button -->
      <button class="mobile-nav-toggle" id="blogNavToggle" type="button" aria-label="Open mobile navigation menu" aria-expanded="false" aria-controls="blogMobileDrawer">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Slide-out Drawer -->
  <div class="mobile-drawer-overlay" id="blogDrawerOverlay" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="blogDrawerBackdrop"></div>
    <div class="mobile-drawer-container" id="blogMobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
      <div class="mobile-drawer-top">
        <a class="ug-logo-group" href="/blog/" aria-label="OllaVPN Blog Home">
          <img src="/logo.png" srcset="/logo.png 1x, /logo@2x.png 2x" alt="OllaVPN Logo" width="36" height="36" class="ug-logo-img" style="width: 36px; height: 36px; border-radius: 8px; display: block;" />
          <div class="ug-logo-text-block">
            <div class="ug-brand-name">olla<span>vpn</span></div>
            <span class="ug-brand-badge">RESEARCH BLOG</span>
          </div>
        </a>
        <button class="mobile-drawer-close-btn" id="blogDrawerClose" type="button" aria-label="Close navigation menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="mobile-drawer-content">
        <!-- Main Quick Links -->
        <div class="mobile-nav-section">
          <div class="mobile-section-label">Navigation</div>
          <a href="/blog/" class="mobile-nav-item">
            <span class="mobile-nav-icon">📚</span>
            <span>All 149 Articles</span>
          </a>
          <a href="https://ollavpn.com/free-vpn" class="mobile-nav-item">
            <span class="mobile-nav-icon">⚡</span>
            <span>Free Unlimited VPN</span>
          </a>
          <a href="https://ollavpn.com/pricing" class="mobile-nav-item">
            <span class="mobile-nav-icon">💎</span>
            <span>Pricing</span>
          </a>
          <a href="https://ollavpn.com/apps.html" class="mobile-nav-item">
            <span class="mobile-nav-icon">📱</span>
            <span>VPN Apps</span>
          </a>
          <a href="https://ollavpn.com/technology.html" class="mobile-nav-item">
            <span class="mobile-nav-icon">🛡️</span>
            <span>Technology &amp; Security</span>
          </a>
        </div>

        <!-- Categories -->
        <div class="mobile-nav-section">
          <div class="mobile-section-label">Research Categories</div>
          <a href="/tags/privacy-security/" class="mobile-nav-item">
            <span class="mobile-nav-icon">🔒</span>
            <span>Privacy &amp; Security</span>
          </a>
          <a href="/tags/protocol-tech/" class="mobile-nav-item">
            <span class="mobile-nav-icon">⚙️</span>
            <span>Protocols &amp; Architecture</span>
          </a>
          <a href="/tags/how-to-guides/" class="mobile-nav-item">
            <span class="mobile-nav-icon">🛠️</span>
            <span>How-To Guides</span>
          </a>
          <a href="/tags/comparisons/" class="mobile-nav-item">
            <span class="mobile-nav-icon">⚖️</span>
            <span>VPN Comparisons</span>
          </a>
          <a href="/tags/buyer-guides/" class="mobile-nav-item">
            <span class="mobile-nav-icon">💡</span>
            <span>Buyer Guides</span>
          </a>
        </div>

        <!-- Mobile Download CTA -->
        <div class="mobile-drawer-footer">
          <a href="https://ollavpn.com/dl/" class="mobile-cta-btn">
            <span>Download Free OllaVPN</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <div class="mobile-cta-subtext">No registration • Zero logs • Free forever</div>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    function initBlogMobileNav() {
      const toggleBtn = document.getElementById('blogNavToggle');
      const closeBtn = document.getElementById('blogDrawerClose');
      const backdrop = document.getElementById('blogDrawerBackdrop');
      const overlay = document.getElementById('blogDrawerOverlay');

      if (!toggleBtn || !overlay) return;

      function openMenu() {
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        toggleBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (overlay.classList.contains('is-open')) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      if (closeBtn) closeBtn.addEventListener('click', closeMenu);
      if (backdrop) backdrop.addEventListener('click', closeMenu);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
          closeMenu();
        }
      });

      overlay.querySelectorAll('a').forEach(function(link) {
        link.addEventListener('click', closeMenu);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogMobileNav);
    } else {
      initBlogMobileNav();
    }
  })();
</script>
