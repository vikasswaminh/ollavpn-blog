---
import { SITE, NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Main Header -->
<header class="site-header">
  <div class="container header-inner">
        <div class="header-left">
      <a class="ug-logo-group" href="/blog/" aria-label="OllaVPN Blog Home">
        <div class="ug-logo-icon">
          <!-- Geometric Shield Eagle Icon -->
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="ug-logo-text-block">
          <div class="ug-brand-name">olla<span>vpn</span></div>
          <span class="ug-brand-badge">RESEARCH BLOG</span>
        </div>
      </a>
    </div>

    <nav class="nav nav-center" aria-label="Primary">
      <!-- Technology Dropdown -->
      <div class="nav-item has-dropdown">
        <a href="/tags/protocol-tech/" class="nav-link dropdown-trigger">
          <span>Technology</span>
          <svg class="nav-arrow" width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 10l5 5 5-5z"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/blog/what-is-post-quantum-cryptography" class="dropdown-link">
            <strong>Post-Quantum Encryption</strong>
            <span>Future-proof NIST-standard lattice security</span>
          </a>
          <a href="/blog/wireguard-vs-openvpn" class="dropdown-link">
            <strong>WireGuard Protocol</strong>
            <span>Lightweight, high-speed 10Gbps tunneling</span>
          </a>
          <a href="/blog/which-free-vpn-does-not-keep-logs" class="dropdown-link">
            <strong>Zero-Logs Architecture</strong>
            <span>RAM-only server infrastructure</span>
          </a>
          <a href="/blog/what-is-a-vpn-kill-switch" class="dropdown-link">
            <strong>Kill Switch Protection</strong>
            <span>Automatic system-level network fallback</span>
          </a>
        </div>
      </div>

      <!-- Blogs Dropdown -->
      <div class="nav-item has-dropdown">
        <a href="/" class="nav-link dropdown-trigger">
          <span>Blogs</span>
          <svg class="nav-arrow" width="9" height="9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 10l5 5 5-5z"/>
          </svg>
        </a>
        <div class="dropdown-menu">
          <a href="/" class="dropdown-link">
            <strong>All Articles (140)</strong>
            <span>Explore our complete library</span>
          </a>
          <a href="/tags/buyer-guides/" class="dropdown-link">
            <strong>Buyer Guides</strong>
            <span>Device &amp; platform recommendations</span>
          </a>
          <a href="/tags/privacy-security/" class="dropdown-link">
            <strong>Privacy &amp; Security</strong>
            <span>Digital footprint &amp; data defense</span>
          </a>
          <a href="/tags/how-to-guides/" class="dropdown-link">
            <strong>How-To Guides</strong>
            <span>Step-by-step setup &amp; configurations</span>
          </a>
          <a href="/tags/comparisons/" class="dropdown-link">
            <strong>VPN Comparisons</strong>
            <span>In-depth head-to-head performance benchmarks</span>
          </a>
        </div>
      </div>

      <!-- Free VPN -->
      <a href="/free-vpn" class="nav-link">
        <span>Free VPN</span>
      </a>

      <!-- Apps -->
      <a href="/tags/use-cases/" class="nav-link">
        <span>Apps</span>
      </a>

      <!-- Download -->
      <a href="https://ollavpn.com/download" class="nav-link">
        <span>Download</span>
      </a>
    </nav>

    <div class="header-right">
      <a class="btn-contact" href={SITE.marketingUrl}>Get OllaVPN</a>
    </div>
  </div>
</header>
