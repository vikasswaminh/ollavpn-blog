---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts } from '../../utils/posts';
import topicClusters from '../../data/topic_clusters.json';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    // 1. Topic clustering algorithm match
    const clusterMatches = (topicClusters as Record<string, any[]>)[post.slug];
    let relatedPosts: any[] = [];
    
    if (clusterMatches && clusterMatches.length >= 3) {
      relatedPosts = clusterMatches.map((item) => {
        const fullPost = posts.find((p) => p.slug === item.slug);
        return fullPost || {
          slug: item.slug,
          data: {
            title: item.title,
            description: item.desc,
            tags: item.tags || []
          }
        };
      });
    } else {
      // Robust normalized tag matching
      const normalize = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
      const postTags = (post.data.tags || []).map(normalize);
      const postCategory = normalize(post.data.category || '');

      const scoredPosts = posts
        .filter((p) => p.slug !== post.slug)
        .map((p) => {
          let score = 0;
          const pTags = (p.data.tags || []).map(normalize);
          const pCategory = normalize(p.data.category || '');

          if (pCategory && pCategory === postCategory) score += 3;
          for (const t of pTags) {
            if (postTags.includes(t)) score += 2;
          }
          return { post: p, score };
        })
        .sort((a, b) => b.score - a.score);

      const topMatches = scoredPosts.map((sp) => sp.post);
      relatedPosts = topMatches.slice(0, 3);

      // Ensure always at least 3 items
      if (relatedPosts.length < 3) {
        const remaining = posts.filter(
          (p) => p.slug !== post.slug && !relatedPosts.some((r) => r.slug === p.slug)
        );
        relatedPosts = [...relatedPosts, ...remaining].slice(0, 3);
      }
    }

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();
---

<PostLayout post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</PostLayout>
