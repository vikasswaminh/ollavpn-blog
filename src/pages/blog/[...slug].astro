---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPublishedPosts } from '../../utils/posts';
import topicClusters from '../../data/topic_clusters.json';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    // 1. Topic clustering algorithm match
    const clusterMatches = (topicClusters as Record<string, any[]>)[post.slug];
    let relatedPosts: any[] = [];
    
    if (clusterMatches && clusterMatches.length > 0) {
      relatedPosts = clusterMatches.map((item) => {
        const fullPost = posts.find((p) => p.slug === item.slug);
        return fullPost || {
          slug: item.slug,
          data: {
            title: item.title,
            description: item.desc,
            tags: item.tags || []
          }
        };
      });
    } else {
      // Fallback to shared tags / category
      const postTags = post.data.tags || [];
      const related = posts
        .filter((p) => p.slug !== post.slug)
        .filter((p) => {
          const pTags = p.data.tags || [];
          return pTags.some((t) => postTags.includes(t));
        })
        .slice(0, 3);
      const fallback = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
      relatedPosts = related.length >= 2 ? related : fallback;
    }

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();
---

<PostLayout post={post} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</PostLayout>
