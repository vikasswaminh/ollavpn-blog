---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const p of posts) for (const t of p.data.tags) tags.add(t);
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://ollavpn.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Tags',
      item: 'https://ollavpn.com/tags/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `#${tag}`,
      item: `https://ollavpn.com/tags/${tag}/`
    }
  ]
};
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <p class="post-eyebrow"><a href="/tags/">← All tags</a></p>
  <h1 class="page-title">#{tag}</h1>
  <div class="post-list">
    {
      posts.map((p) => (
        <PostCard
          url={`/blog/${p.slug}/`}
          title={p.data.title}
          description={p.data.description}
          pubDate={p.data.pubDate}
          tags={p.data.tags}
          minutes={readingTime(p.body)}
        />
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
