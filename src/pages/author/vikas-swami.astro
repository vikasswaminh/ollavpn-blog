---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = "Vikas Swami - Founder & Creator | OllaVPN";
const pageDescription = "Meet Mr. Vikas Swami, Dual CCIE #22239, former Cisco TAC VPN escalation engineer, and founder of Networkers Home, QuickZTNA, and OllaVPN.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="author-profile-page">
    
    <!-- Breadcrumb Navigation -->
    <div class="author-breadcrumb-wrap">
      <div class="author-container">
        <nav class="author-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="bc-sep" aria-hidden="true">&rsaquo;</span>
          <span class="bc-curr">Editorial Leadership &amp; Engineering</span>
          <span class="bc-sep" aria-hidden="true">&rsaquo;</span>
          <span class="bc-active">Vikas Swami</span>
        </nav>
      </div>
    </div>

    <!-- Centered Profile Hero (Matching Screenshot 3) -->
    <header class="author-hero">
      <div class="author-avatar-wrap">
        <img 
          src="/images/vikas-swami-avatar.webp" 
          alt="Mr. Vikas Swami" 
          class="author-avatar-img" 
          width="136" 
          height="136"
        />
      </div>
      <h1 class="author-hero-name">Vikas Swami</h1>
      <p class="author-hero-subtitle">
        Founder &amp; Creator at OllaVPN &bull; Dual CCIE #22239 (Routing &amp; Switching, Security)
      </p>
      
      <div class="author-hero-badges">
        <span class="author-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Dual CCIE #22239
        </span>
        <span class="author-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          Ex-Cisco TAC VPN
        </span>
        <span class="author-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          NUS Innovation Fellow
        </span>
        <span class="author-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          Founder, Networkers Home (Est. 2007)
        </span>
      </div>
    </header>

    <!-- Main 2-Column Content Grid (Matching Screenshot 3) -->
    <div class="author-container">
      <div class="author-grid-layout">
        
        <!-- Left Column: Biography and Articles (Matching Screenshot 3) -->
        <div class="author-main-col">
          
          <!-- About Section Card -->
          <section class="author-card author-about-card">
            <div class="author-card-header">
              <h2 class="author-card-title">About</h2>
              <span class="author-toggle-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="18 15 12 9 6 15"></polyline>
                </svg>
              </span>
            </div>
            
            <div class="author-card-body">
              <p>
                Mr. Vikas Swami founded <a href="https://networkershome.com" target="_blank" rel="noopener noreferrer" class="author-inline-link"><strong>Networkers Home</strong></a> in 2007 and continues to run it from HSR Layout, Bangalore. He holds <strong>Dual CCIE #22239</strong> &mdash; Routing &amp; Switching, cleared in October 2008, and Security, cleared in January 2009. The two lab exams were passed within ninety days of each other, placing him among very few engineers worldwide to have completed two CCIE-level lab certifications in such a short window. The CCIE lab is an eight-hour hands-on practical examination; most engineers take three to five years between two CCIE certifications.
              </p>
              
              <p>
                He is a mechanical engineer by training, with a specialization in Production Engineering and Industrial Management. He later completed the <strong>Executive Program in Innovation at the National University of Singapore</strong>. Before founding Networkers Home, he worked at <strong>Wipro, HP, Cisco, and Mobily</strong> &mdash; the Saudi Arabian carrier. His tenure at Cisco included a role on the <strong>TAC VPN team in 2004</strong>, the global escalation desk responsible for resolving VPN failures across Cisco's enterprise and carrier customer base. That role is the technical foundation behind the VPN-domain companies he has built since.
              </p>
              
              <p>
                His current work spans five domains. In the VPN industry, he is the founder of <strong>QuickZTNA</strong> (zero-trust network access), <strong>QuickSDWAN</strong> (software-defined WAN), <strong>21Tunnel</strong> (secure tunnel infrastructure), <strong>OllaVPN</strong> (consumer VPN), and <strong>MeshWG</strong> (a hosted mesh VPN that turns existing routers and servers into private networks without complex clouds).
              </p>
            </div>
          </section>

          <!-- Engineering Leadership & Articles -->
          <section class="author-card author-research-card">
            <div class="author-card-header">
              <h2 class="author-card-title">Core Research &amp; Architectural Focus</h2>
            </div>
            <div class="author-card-body">
              <p class="author-research-intro">
                Under Mr. Vikas Swami's architectural leadership, OllaVPN focuses on pioneering next-generation post-quantum resilience, WireGuard kernel acceleration, and audited zero-retention topologies:
              </p>

              <div class="author-articles-grid">
                <a href="/blog/what-is-a-post-quantum-vpn/" class="author-article-item">
                  <div class="author-article-tag">Cryptography &bull; Lead Story</div>
                  <h3 class="author-article-title">What Is a Post-Quantum VPN and Why Do You Need One?</h3>
                  <p class="author-article-desc">An executive guide to ML-KEM lattice key encapsulation and defending against the Harvest Now, Decrypt Later threat.</p>
                  <span class="author-article-link">Read Architectural Analysis &rarr;</span>
                </a>

                <a href="/blog/wireguard-vs-openvpn/" class="author-article-item">
                  <div class="author-article-tag">Protocol Engineering</div>
                  <h3 class="author-article-title">WireGuard vs. OpenVPN: Which Protocol Should You Trust?</h3>
                  <p class="author-article-desc">A deep dive into 4,000 lines of kernel code versus legacy OpenVPN cryptographic bloat and packet latency.</p>
                  <span class="author-article-link">Read Protocol Analysis &rarr;</span>
                </a>

                <a href="/blog/what-is-masque/" class="author-article-item">
                  <div class="author-article-tag">Next-Gen Tunneling</div>
                  <h3 class="author-article-title">MASQUE Protocol Explained: HTTP/3 Datagrams in Corporate Networks</h3>
                  <p class="author-article-desc">How modern tunneling bypasses rigid corporate deep packet inspection using QUIC multiplexing.</p>
                  <span class="author-article-link">Read Technical Breakdown &rarr;</span>
                </a>

                <a href="/blog/what-is-multi-hop-vpn/" class="author-article-item">
                  <div class="author-article-tag">Network Topology</div>
                  <h3 class="author-article-title">What is Multi-Hop VPN and How Does it Boost Your Privacy?</h3>
                  <p class="author-article-desc">Cascaded encrypted tunnels across independent server jurisdictions preventing adversary correlation.</p>
                  <span class="author-article-link">Read Topology Guide &rarr;</span>
                </a>
              </div>
            </div>
          </section>

        </div>

        <!-- Right Column: Sidebar Credentials (Matching Screenshot 3) -->
        <aside class="author-sidebar-col">
          
          <!-- Card 1: Education (Exact structure from Screenshot 3) -->
          <div class="author-card author-side-card">
            <h2 class="author-card-title">Education</h2>
            <ul class="author-bullets-list">
              <li>
                <strong>Dual CCIE #22239</strong> &mdash; Routing &amp; Switching (Oct 2008) &amp; Security (Jan 2009). Both labs cleared within a record 90-day window.
              </li>
              <li>
                <strong>Executive Program in Innovation</strong>, National University of Singapore (NUS).
              </li>
              <li>
                <strong>B.E. in Mechanical Engineering</strong>, Specialization in Production Engineering and Industrial Management.
              </li>
            </ul>
          </div>

          <!-- Card 2: Areas of Expertise (Matching Screenshot 3) -->
          <div class="author-card author-side-card">
            <h2 class="author-card-title">Areas of Expertise</h2>
            <ul class="author-bullets-list">
              <li>Post-Quantum Cryptography &amp; NIST ML-KEM Lattice Encapsulation</li>
              <li>Enterprise VPN Failure Recovery &amp; TAC Escalation Engineering</li>
              <li>WireGuard Kernel-Level Tunneling &amp; High-Throughput Meshing</li>
              <li>Zero-Trust Network Access (ZTNA) &amp; Software-Defined WAN</li>
              <li>Carrier-Grade Routing Protocols (BGP, MPLS, OSPF, IPsec)</li>
              <li>RAM-Only Ephemeral Infrastructure &amp; DNS Leak Mitigation</li>
            </ul>
          </div>

          <!-- Card 3: Ventures & Industry Leadership (From Screenshot 2) -->
          <div class="author-card author-side-card">
            <h2 class="author-card-title">Ventures &amp; Companies</h2>
            <ul class="author-bullets-list">
              <li>
                <strong>OllaVPN</strong> &mdash; Consumer Privacy &amp; Post-Quantum VPN
              </li>
              <li>
                <strong><a href="https://networkershome.com" target="_blank" rel="noopener noreferrer" class="author-inline-link">Networkers Home</a></strong> &mdash; Founder (Bangalore, Est. 2007)
              </li>
              <li>
                <strong>QuickZTNA</strong> &mdash; Enterprise Zero-Trust Network Access
              </li>
              <li>
                <strong>QuickSDWAN</strong> &mdash; Software-Defined WAN Infrastructure
              </li>
              <li>
                <strong>21Tunnel &amp; MeshWG</strong> &mdash; High-Speed Mesh Tunneling
              </li>
              <li>
                <strong>Past Career</strong> &mdash; Cisco (TAC VPN, 2004), Wipro, HP, Mobily
              </li>
            </ul>
          </div>

        </aside>

      </div>
    </div>

  </main>
</BaseLayout>

<style>
  .author-profile-page {
    background-color: #FFF5F5;
    color: #0F172A;
    padding-bottom: 5rem;
    min-height: 80vh;
  }

  .author-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Breadcrumb Navigation */
  .author-breadcrumb-wrap {
    background: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    padding: 0.85rem 0;
    margin-bottom: 2.5rem;
  }

  .author-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: #64748B;
  }

  .author-breadcrumb a {
    color: #DA291C;
    text-decoration: none;
    font-weight: 500;
  }

  .author-breadcrumb a:hover {
    text-decoration: underline;
  }

  .bc-sep {
    color: #DA291C;
    font-size: 1.1rem;
    line-height: 1;
  }

  .bc-curr {
    color: #64748B;
  }

  .bc-active {
    color: #0F172A;
    font-weight: 600;
  }

  /* Hero Section (Matching Screenshot 3) */
  .author-hero {
    text-align: center;
    padding: 1rem 1.5rem 3rem;
    max-width: 860px;
    margin: 0 auto;
  }

  .author-avatar-wrap {
    width: 136px;
    height: 136px;
    margin: 0 auto 1.35rem;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(91, 58, 112, 0.22), 0 2px 6px rgba(0, 0, 0, 0.08);
    border: 4px solid #FFFFFF;
    background: #0F172A;
  }

  .author-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .author-hero-name {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 2.35rem;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.025em;
    margin: 0 0 0.6rem;
  }

  .author-hero-subtitle {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.5;
    margin: 0 auto 1.5rem;
    max-width: 650px;
  }

  .author-hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .author-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #A61E1E;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    box-shadow: 0 2px 4px rgba(33, 26, 37, 0.04);
  }

  .author-badge svg {
    color: #DA291C;
  }

  /* 2-Column Main Grid (Matching Screenshot 3) */
  .author-grid-layout {
    display: grid;
    grid-template-columns: 1.85fr 1.15fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 900px) {
    .author-grid-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }

  /* White Profile Cards */
  .author-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(33, 26, 37, 0.04);
    margin-bottom: 2rem;
  }

  .author-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #FFF8F8;
  }

  .author-card-title {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.28rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0;
  }

  .author-toggle-icon {
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-card-body p {
    font-size: 0.98rem;
    line-height: 1.72;
    color: #382F3F;
    margin: 0 0 1.25rem;
  }

  .author-card-body p:last-child {
    margin-bottom: 0;
  }

  .author-inline-link {
    color: #DA291C;
    text-decoration: underline;
    font-weight: 600;
  }

  .author-inline-link:hover {
    color: #DA291C;
  }

  /* Bullets List in Sidebar (Matching Screenshot 3) */
  .author-bullets-list {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .author-bullets-list li {
    font-size: 0.93rem;
    line-height: 1.6;
    color: #382F3F;
  }

  .author-bullets-list li strong {
    color: #0F172A;
  }

  /* Research Articles Grid */
  .author-research-intro {
    font-size: 0.95rem;
    color: #475569;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .author-articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.15rem;
  }

  @media (max-width: 600px) {
    .author-articles-grid {
      grid-template-columns: 1fr;
    }
  }

  .author-article-item {
    background: #FAF7FB;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 1.15rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
  }

  .author-article-item:hover {
    transform: translateY(-3px);
    border-color: #DA291C;
    box-shadow: 0 6px 16px rgba(91, 58, 112, 0.1);
  }

  .author-article-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #DA291C;
    margin-bottom: 0.45rem;
  }

  .author-article-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.35;
    margin: 0 0 0.5rem;
  }

  .author-article-desc {
    font-size: 0.84rem;
    color: #475569;
    line-height: 1.5;
    margin: 0 0 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .author-article-link {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 700;
    color: #DA291C;
  }
</style>
