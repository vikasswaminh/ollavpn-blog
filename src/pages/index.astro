---
import UpgradLayout from '../layouts/UpgradLayout.astro';
import { getPublishedPosts, readingTime } from '../utils/posts';

const allPosts = await getPublishedPosts();

// Smart Topic Clustering: 8 Mother Topics
const categoryKeys = [
  "All",
  "privacy-security",
  "protocol-tech",
  "pillars",
  "buyer-guides",
  "beginner-basics",
  "how-to-guides",
  "comparisons",
  "use-cases"
];

const categoryLabels: Record<string, string> = {
  "All": "All Articles",
  "privacy-security": "Privacy & Threat Defense",
  "protocol-tech": "Protocols & Next-Gen Tech",
  "pillars": "Post-Quantum Cryptography",
  "buyer-guides": "Buyer Guides & Audits",
  "beginner-basics": "Beginner Basics",
  "how-to-guides": "Platform Setup & Guides",
  "comparisons": "VPN Comparisons",
  "use-cases": "Streaming & Use Cases"
};

// Heuristic Primary Category Classifier
function getPrimaryCategory(slug: string, tags: string[] = []): string {
  for (const cat of ["pillars", "protocol-tech", "privacy-security", "buyer-guides", "comparisons", "how-to-guides", "beginner-basics", "use-cases"]) {
    if (tags.includes(cat)) return cat;
  }
  const s = slug.toLowerCase();
  if (s.includes('quantum') || s.includes('cryptography') || s.includes('pqc') || s.includes('lattice')) return 'pillars';
  if (s.includes('wireguard') || s.includes('protocol') || s.includes('masque') || s.includes('openvpn') || s.includes('quic') || s.includes('tunnel') || s.includes('concentrator')) return 'protocol-tech';
  if (s.includes('vs-') || s.includes('-vs-') || s.includes('versus') || s.includes('comparison')) return 'comparisons';
  if (s.includes('how-to') || s.includes('setup') || s.includes('fix') || s.includes('test') || s.includes('delete-') || s.includes('find-saved')) return 'how-to-guides';
  if (s.includes('wifi') || s.includes('wi-fi') || s.includes('streaming') || s.includes('netflix') || s.includes('travel') || s.includes('gaming') || s.includes('telegram') || s.includes('whatsapp') || s.includes('torrent') || s.includes('banking') || s.includes('crypto')) return 'use-cases';
  if (s.includes('best-') || s.includes('free-vpn-for-') || s.includes('audit') || s.includes('review') || s.includes('paid-vpn') || s.includes('why-are-free')) return 'buyer-guides';
  if (s.includes('what-is') || s.includes('why-') || s.includes('safe') || s.includes('burner-') || s.includes('captcha') || s.includes('ssid')) return 'beginner-basics';
  return 'privacy-security';
}

// Compute dynamic count for each category
const categoryCounts: Record<string, number> = { "All": allPosts.length };
for (const key of categoryKeys) {
  if (key !== "All") categoryCounts[key] = 0;
}
for (const post of allPosts) {
  const cat = getPrimaryCategory(post.slug, post.data.tags || []);
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}

// Hero Lead Story: Post-Quantum VPN or Newest Post
const leadStory = allPosts.find(p => p.slug === 'what-is-a-post-quantum-vpn') || allPosts[0];
const leadReadTime = readingTime(leadStory.body);

// Curated 2D WebP Visuals Mapping
function getPostImage(category: string): string {
  return `/images/category-${category}.webp`;
}

function formatDate(d: Date | string) {
  const date = new Date(d);
  return date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
}

// Top Curricula Tracks
const curriculumTracks = [
  {
    tag: "TRACK 01",
    title: "VPN Fundamentals & Zero-Logs Architecture",
    desc: "Master cryptographic tunneling, packet encapsulation, and no-logs server infrastructure audited for 2026.",
    guides: [
      { title: "What Is a VPN and How Does It Work?", slug: "what-is-a-vpn-and-how-does-it-work" },
      { title: "Free VPN vs Paid VPN: Full Architecture Breakdown", slug: "free-vpn-vs-paid-vpn" },
      { title: "What Logs Does a VPN Actually Keep?", slug: "what-logs-does-vpn-keep" },
      { title: "Why Are Free VPNs Free? The Monetization Truth", slug: "why-are-free-vpns-free" }
    ],
    duration: "4 Modules • 45 min"
  },
  {
    tag: "TRACK 02",
    title: "Threat Defense & Leak Prevention Lab",
    desc: "Audit DNS exposure, WebRTC leaks, and system-level kill switch mechanisms to protect against deep-packet inspection.",
    guides: [
      { title: "What Is a DNS Leak & How to Prevent Data Exposure", slug: "what-is-a-dns-leak" },
      { title: "What Is a VPN Kill Switch & When to Keep It On", slug: "what-is-a-vpn-kill-switch" },
      { title: "What is a WebRTC Leak & Why It Matters for Privacy", slug: "what-is-a-webrtc-leak" },
      { title: "What Your ISP Can See About You (And How to Hide It)", slug: "what-your-isp-can-see-about-you" }
    ],
    duration: "4 Modules • 1 hr"
  },
  {
    tag: "TRACK 03",
    title: "Next-Gen Protocols & Quantum Security",
    desc: "Benchmark WireGuard vs OpenVPN throughput, implement MASQUE RFC 9298, and deploy NIST ML-KEM lattice cryptography.",
    guides: [
      { title: "What Is a Post-Quantum VPN? (2026 Security Guide)", slug: "what-is-a-post-quantum-vpn" },
      { title: "WireGuard vs OpenVPN: Speed & Latency Benchmarks", slug: "wireguard-vs-openvpn" },
      { title: "MASQUE Protocol Explained: Proxying UDP over HTTP/3", slug: "what-is-masque" },
      { title: "What Is Post-Quantum Cryptography? (NIST Standards)", slug: "what-is-post-quantum-cryptography" }
    ],
    duration: "4 Modules • 1.5 hrs"
  }
];
---

<UpgradLayout
  title="OllaVPN Blog | Cybersecurity, Protocols & Quantum Defense"
  description="140 peer-reviewed technical guides, protocol benchmarks, DNS leak testing, and post-quantum VPN architecture verified for 2026."
>
  
  <!-- BreadcrumbList Schema JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ollavpn.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://ollavpn.com/blog/"
      }
    ]
  }
  </script>

  <div class="ug-container">

    <!-- 1. BREADCRUMBS -->
    <nav class="ug-breadcrumb-bar" aria-label="Breadcrumb">
      <a href="https://ollavpn.com/">Home</a>
      <span class="ug-breadcrumb-sep">&rsaquo;</span>
      <a href="/blog/">Blog</a>
      <span class="ug-breadcrumb-sep">&rsaquo;</span>
      <span class="ug-breadcrumb-current" id="ug-breadcrumb-active">All Articles</span>
    </nav>

    <!-- 2. HERO FEATURED SECTION -->
    <section class="ug-hero-section" aria-labelledby="hero-title">
      <div class="ug-hero-header">
        <h1 id="hero-title" class="ug-hero-h1">OllaVPN <span>Research &amp; Blogs</span></h1>
      </div>

      <article class="ug-hero-card">
        <!-- Hero Content Column -->
        <div class="ug-hero-content">
          <div>
            <div class="ug-meta-row">
              <span class="ug-badge">Post-Quantum Cryptography</span>
              <span>&bull;</span>
              <time datetime="2026-07-04">{formatDate(leadStory.data.pubDate)}</time>
              <span>&bull;</span>
              <span>{leadReadTime} min read</span>
            </div>

            <h2 class="ug-hero-title">
              <a href={`/blog/${leadStory.slug}.html`}>
                {leadStory.data.title}
              </a>
            </h2>

            <p class="ug-hero-excerpt">
              {leadStory.data.description}
            </p>
          </div>

          <!-- Author Byline -->
          <div class="ug-author-bar">
            <img 
              src="/images/vikas-swami-avatar.webp" 
              alt="Mr. Vikas Swami" 
              class="ug-author-avatar"
              width="36"
              height="36"
              loading="eager"
            />
            <div>
              <div class="ug-author-name">Mr. Vikas Swami</div>
              <div class="ug-author-role">Dual CCIE #22239 &bull; Network Security Architect</div>
            </div>
          </div>
        </div>

        <!-- Hero Media Column -->
        <div class="ug-hero-media">
          <a href={`/blog/${leadStory.slug}.html`} style="display:block; width:100%; height:100%;" aria-label={leadStory.data.title}>
            <img 
              src="/images/category-pillars.webp" 
              alt={leadStory.data.title}
              width="650"
              height="400"
              loading="eager"
            />
          </a>
        </div>
      </article>
    </section>

    <!-- 3. DISCOVER BLOGS BY CATEGORIES -->
    <section class="ug-category-section" id="categories-section" aria-labelledby="cat-heading">
      
      <div class="ug-section-header">
        <div>
          <h2 id="cat-heading" class="ug-section-title">
            Explore by <span style="color:var(--ug-primary);">Cybersecurity Category</span>
          </h2>
          <p style="font-size:0.92rem; color:var(--ug-text-muted); margin-top:0.35rem;">
            Filter 140 technical guides by threat model, protocol architecture, or platform.
          </p>
        </div>
        <div id="ug-active-count" style="font-size:0.88rem; font-weight:700; color:var(--ug-primary); background:var(--ug-primary-tint); padding:0.35rem 0.85rem; border-radius:9999px;">
          Showing {allPosts.length} articles
        </div>
      </div>

      <div class="ug-discover-layout">
        
        <!-- Left: Smart Topic Clusters (Sidebar on Desktop, Horizontal Scroll on Mobile) -->
        <aside class="ug-category-sidebar" aria-label="Article Categories">
          {categoryKeys.map((catKey, idx) => (
            <button 
              type="button" 
              class={`ug-cat-btn ${idx === 0 ? 'active' : ''}`}
              data-category={catKey}
              data-label={categoryLabels[catKey]}
              id={`tab-${catKey}`}
            >
              <span>{categoryLabels[catKey]}</span>
              <div style="display:flex; align-items:center; gap:0.5rem;">
                <span class="ug-count-pill" style="font-size:0.75rem; background:#F1F5F9; color:#475569; padding:0.15rem 0.5rem; border-radius:999px; font-weight:600;">
                  {categoryCounts[catKey]}
                </span>
                <svg class="ug-cat-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </div>
            </button>
          ))}
        </aside>

        <!-- Right: Responsive Fluid Card Grid + Pagination -->
        <div class="ug-cards-container">
          <div class="ug-grid-3" id="ug-posts-grid">
            {allPosts.map((post, idx) => {
              const tags = post.data.tags || [];
              const readTime = readingTime(post.body);
              const primaryCategory = getPrimaryCategory(post.slug, tags);
              const categoryLabel = categoryLabels[primaryCategory] || 'Cybersecurity';
              const imgSrc = getPostImage(primaryCategory);
              const authorName = post.data.author && post.data.author !== 'OllaVPN Team' ? post.data.author : 'Vikas Swami';
              
              return (
                <article 
                  class="ug-card-clean" 
                  data-category={primaryCategory}
                  data-tags={tags.join(' ')} 
                  data-title={post.data.title.toLowerCase()}
                  data-index={idx}
                >
                  <a href={`/blog/${post.slug}.html`} class="ug-card-clean-media" aria-label={post.data.title}>
                    <!-- Red Bookmark Ribbon Badge -->
                    <div class="ug-card-ribbon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/>
                      </svg>
                    </div>

                    <img 
                      src={imgSrc} 
                      alt={post.data.title} 
                      width="800"
                      height="500"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>

                  <div class="ug-card-clean-body">
                    <div class="ug-card-clean-category">
                      {categoryLabel}
                    </div>

                    <h3 class="ug-card-clean-title">
                      <a href={`/blog/${post.slug}.html`}>
                        {post.data.title}
                      </a>
                    </h3>

                    <div class="ug-card-clean-meta">
                      <div class="ug-card-clean-author">
                        By {authorName}
                      </div>
                      <span class="ug-card-clean-date">
                        {formatDate(post.data.pubDate)} | {readTime} min read
                      </span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Interactive Pagination -->
          <div class="ug-pagination" id="ug-pagination-bar" role="navigation" aria-label="Pagination">
            <button type="button" class="ug-page-btn" id="ug-prev-page" aria-label="Previous page" disabled>&lsaquo;</button>
            <div id="ug-page-numbers" style="display:flex; gap:0.5rem; align-items:center;"></div>
            <button type="button" class="ug-page-btn" id="ug-next-page" aria-label="Next page">&rsaquo;</button>
          </div>
        </div>

      </div>
    </section>

  </div>

  <!-- 4. MODULAR CURRICULA TRACKS -->
  <section class="ug-curriculum-section" id="curriculum-section" aria-labelledby="curriculum-heading">
    
  <!-- BreadcrumbList Schema JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ollavpn.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://ollavpn.com/blog/"
      }
    ]
  }
  </script>

  <div class="ug-container">
      <div class="ug-section-header">
        <div>
          <h2 id="curriculum-heading" class="ug-section-title">
            Get Started with <span style="color:var(--ug-primary);">Core Curricula</span>
          </h2>
          <p style="font-size:0.92rem; color:var(--ug-text-muted); margin-top:0.35rem;">
            Structured learning tracks designed by Dual CCIE #22239 network security architects.
          </p>
        </div>
      </div>

      <div class="ug-curriculum-grid">
        {curriculumTracks.map(track => (
          <div class="ug-track-card">
            <div>
              <div class="ug-track-header">
                <span class="ug-track-tag">{track.tag}</span>
                <h3 class="ug-track-title">{track.title}</h3>
                <p class="ug-track-desc">{track.desc}</p>
              </div>

              <ul class="ug-track-items">
                {track.guides.map(g => (
                  <li class="ug-track-item">
                    <span class="ug-track-bullet">&rarr;</span>
                    <a href={`/blog/${g.slug}.html`}>{g.title}</a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="ug-track-footer">
              <span class="ug-track-badge">{track.duration}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. DUAL CCIE ADVISORY & LAB AUDITS SECTION -->
  <section class="ug-support-section" id="support-section">
    
  <!-- BreadcrumbList Schema JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ollavpn.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://ollavpn.com/blog/"
      }
    ]
  }
  </script>

  <div class="ug-container">
      <div class="ug-support-grid">
        <!-- Card 1 -->
        <div class="ug-support-card">
          <div class="ug-support-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div>
            <h3 class="ug-support-h3">Dual CCIE #22239 Verified</h3>
            <p class="ug-support-desc">
              Every technical article is peer-reviewed by Cisco-certified internetwork architects to ensure cryptographic accuracy and rigorous security standards.
            </p>
            <a href="/author/vikas-swami/" class="ug-support-link">
              <span>Read Architecture Profile</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="ug-support-card">
          <div class="ug-support-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <div>
            <h3 class="ug-support-h3">Zero-Logs Protocol Audits</h3>
            <p class="ug-support-desc">
              Independent packet capture inspections, RAM-only diskless node verifications, and cryptographic handshake reviews.
            </p>
            <a href="/blog/which-free-vpn-does-not-keep-logs.html" class="ug-support-link">
              <span>View Audit Reports</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="ug-support-card">
          <div class="ug-support-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div>
            <h3 class="ug-support-h3">Community &amp; Leak Testing</h3>
            <p class="ug-support-desc">
              Clear, transparent guides on WireGuard throughput, DNS leak diagnostics, WebRTC prevention, and kill switch configurations.
            </p>
            <a href="/blog/how-to-test-for-dns-leak.html" class="ug-support-link">
              <span>Run Leak Diagnostics</span> &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-Side Interactive Filtering, Search & Pagination Script -->
  <script is:inline>
    (function() {
      const POSTS_PER_PAGE = 12; // 12 cards per page for optimal viewing
      let activeCategory = 'All';
      let searchQuery = '';
      let currentPage = 1;

      const cards = Array.from(document.querySelectorAll('.ug-card-clean'));
      const catBtns = Array.from(document.querySelectorAll('.ug-cat-btn'));
      const countDisplay = document.getElementById('ug-active-count');
      const breadcrumbActive = document.getElementById('ug-breadcrumb-active');
      const searchInput = document.getElementById('ug-nav-search');
      const pageNumbersContainer = document.getElementById('ug-page-numbers');
      const prevBtn = document.getElementById('ug-prev-page');
      const nextBtn = document.getElementById('ug-next-page');

      function filterCards() {
        let matching = cards.filter(card => {
          const category = card.getAttribute('data-category') || '';
          const tags = (card.getAttribute('data-tags') || '').split(' ');
          const title = card.getAttribute('data-title') || '';
          
          const matchesCat = activeCategory === 'All' || category === activeCategory || tags.includes(activeCategory);
          const matchesSearch = !searchQuery || title.includes(searchQuery);
          
          return matchesCat && matchesSearch;
        });

        const totalMatching = matching.length;
        const totalPages = Math.max(1, Math.ceil(totalMatching / POSTS_PER_PAGE));
        if (currentPage > totalPages) currentPage = 1;

        if (countDisplay) {
          countDisplay.textContent = `Showing ${totalMatching} articles`;
        }

        // Hide all cards first
        cards.forEach(card => card.style.display = 'none');

        // Show cards for current page
        const startIdx = (currentPage - 1) * POSTS_PER_PAGE;
        const endIdx = startIdx + POSTS_PER_PAGE;
        matching.slice(startIdx, endIdx).forEach(card => {
          card.style.display = 'flex';
        });

        renderPagination(totalPages);
      }

      function renderPagination(totalPages) {
        if (!pageNumbersContainer) return;
        pageNumbersContainer.innerHTML = '';

        if (prevBtn) prevBtn.disabled = currentPage <= 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

        for (let i = 1; i <= totalPages; i++) {
          if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `ug-page-btn ${i === currentPage ? 'active' : ''}`;
            btn.textContent = i;
            btn.addEventListener('click', () => {
              currentPage = i;
              filterCards();
              const section = document.getElementById('categories-section');
              if (section) section.scrollIntoView({ behavior: 'smooth' });
            });
            pageNumbersContainer.appendChild(btn);
          } else if (
            (i === currentPage - 2 && i > 1) ||
            (i === currentPage + 2 && i < totalPages)
          ) {
            const span = document.createElement('span');
            span.style.padding = '0 0.3rem';
            span.style.alignSelf = 'center';
            span.textContent = '...';
            pageNumbersContainer.appendChild(span);
          }
        }
      }

      // Sidebar Category Button Click Handling
      catBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          catBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeCategory = btn.getAttribute('data-category') || 'All';
          const label = btn.getAttribute('data-label') || 'All Articles';
          if (breadcrumbActive) breadcrumbActive.textContent = label;
          currentPage = 1;
          filterCards();
        });
      });

      // Search Handling
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          currentPage = 1;
          filterCards();
        });

        // Shortcut /
        window.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      // Prev / Next Page Buttons
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            filterCards();
            const section = document.getElementById('categories-section');
            if (section) section.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentPage++;
          filterCards();
          const section = document.getElementById('categories-section');
          if (section) section.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Initial filter run
      filterCards();
    })();
  </script>
</UpgradLayout>
