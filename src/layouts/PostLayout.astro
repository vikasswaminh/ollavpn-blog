---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';

interface Props {
  post: any;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: any[];
}

const { post, headings = [], relatedPosts = [] } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.author,
  cover,
  tags = [],
  canonical = Astro.url.href,
} = post.data;

const minutes = Math.max(3, Math.ceil((post.body ? post.body.split(/\s+/).length : 1500) / 220));

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

const updatedFormattedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : formattedDate;

const firstTag = tags && tags[0] ? tags[0].replace(/-/g, ' ') : 'buyer guide';


const categoryMap: Record<string, string> = {
  "privacy-security": "Privacy & Security",
  "protocol-tech": "Protocols & Technology",
  "pillars": "Post-Quantum Cryptography",
  "buyer-guides": "Buyer Guides & Audits",
  "beginner-basics": "Beginner Basics",
  "how-to-guides": "How-To Guides",
  "comparisons": "Comparisons",
  "use-cases": "Use Cases"
};
const categorySlug = post.data.category || (tags && tags[0] ? tags[0] : 'protocol-tech');
const categoryName = categoryMap[categorySlug] || (firstTag.charAt(0).toUpperCase() + firstTag.slice(1));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://blogs.ollavpn.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://blogs.ollavpn.com/blog/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryName,
      item: `https://blogs.ollavpn.com/blog/?cat=${categorySlug}`
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
      item: `https://blogs.ollavpn.com/blog/${post.slug}/`
    }
  ]
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
  fullWidth={true}
>
  <main class="page-container-24obs">
    <div class="layout-flex-24obs">
      
      <!-- LEFT SIDEBAR: Minimized Navigation -->
      <aside class="desktop-sidebar-24obs left-sidebar">
        <div class="sidebar-header-pill-wrap">
          <span class="sidebar-pill-badge">
            FEATURED GUIDES
          </span>
        </div>
        <nav class="sidebar-nav-list">
          <a href="/blog/free-vpn-for-public-wifi-security/" class="sidebar-nav-item">
            Free VPN for Public Wi-Fi Security (2026)
          </a>
          <a href="/blog/how-public-wifi-steals-passwords/" class="sidebar-nav-item">
            How Public Wi-Fi Steals Passwords
          </a>
          <a href="/blog/vpn-for-public-wifi-traveler/" class="sidebar-nav-item">
            VPN for Public Wi-Fi Traveler Guide
          </a>
          <a href="/blog/free-vpn-for-public-wifi-guide/" class="sidebar-nav-item">
            Free VPN for Public WiFi: Setup
          </a>
          <a href="/blog/vpn-for-traveling-abroad/" class="sidebar-nav-item">
            VPN for Traveling Abroad in 2026
          </a>
          <a href="/blog/can-a-vpn-stop-hackers/" class="sidebar-nav-item">
            Can a VPN Stop Hackers on Wi-Fi?
          </a>
          <a href="/blog/vpn-for-online-banking/" class="sidebar-nav-item">
            VPN for Safe Online Banking
          </a>
          <a href="/blog/free-vpn-for-iphone/" class="sidebar-nav-item">
            Best Free VPN for iPhone &amp; iOS
          </a>
          <a href="/blog/best-free-vpn-for-android/" class="sidebar-nav-item">
            Best Free VPN for Android Devices
          </a>
          <a href="/blog/best-free-vpn-for-windows/" class="sidebar-nav-item">
            Best Free VPN for Windows 11
          </a>
        </nav>
        <a href="/tags/buyer-guides/" class="sidebar-view-all-link">
          View All Guides &rarr;
        </a>
      </aside>

      <!-- CENTER MAIN CONTENT COLUMN -->
      <article class="article-center-col">
        
        <!-- Header: Eyebrow, H1, Subtitle -->
        <header class="article-header">
        <!-- Structural Breadcrumbs -->
        <nav class="article-breadcrumbs" aria-label="Breadcrumb">
          <ol itemscope itemtype="https://schema.org/BreadcrumbList" class="breadcrumbs-list">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
              <a itemprop="item" href="/" class="breadcrumb-link">
                <span itemprop="name">Home</span>
              </a>
              <meta itemprop="position" content="1" />
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
              <a itemprop="item" href="/blog/" class="breadcrumb-link">
                <span itemprop="name">Blog</span>
              </a>
              <meta itemprop="position" content="2" />
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
              <a itemprop="item" href={`/blog/?cat=${categorySlug}`} class="breadcrumb-link">
                <span itemprop="name">{categoryName}</span>
              </a>
              <meta itemprop="position" content="3" />
            </li>
            <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item current">
              <span itemprop="name" class="breadcrumb-current" aria-current="page">{title}</span>
              <meta itemprop="position" content="4" />
            </li>
          </ol>
        </nav>

          <div class="article-meta-row">
            <span>{firstTag.toUpperCase()}</span>
            <span>&bull;</span>
            <span>UPDATED {updatedFormattedDate.toUpperCase()}</span>
            <span>&bull;</span>
            <span>{minutes} MIN READ</span>
          </div>
          <h1 class="article-main-title">
            {title}
          </h1>
          <p class="article-main-desc">
            {description}
          </p>
        </header>

        <!-- Markdown Article Prose Slot -->
        <div class="prose">
          <slot />
        </div>

      </article>

      <!-- RIGHT SIDEBAR: Minimized Navigation + Minimized Promo Card -->
      <aside class="desktop-sidebar-24obs right-sidebar">
        <div class="sidebar-header-pill-wrap">
          <span class="sidebar-pill-badge">
            VPN PROTOCOLS &amp; TECH
          </span>
        </div>
        <nav class="sidebar-nav-list">
          <a href="/blog/wireguard-vs-openvpn/" class="sidebar-nav-item">
            WireGuard vs. OpenVPN Comparison
          </a>
          <a href="/blog/wireguard-vs-ikev2/" class="sidebar-nav-item">
            WireGuard vs IKEv2: Speed &amp; Latency
          </a>
          <a href="/blog/what-is-a-vpn-kill-switch/" class="sidebar-nav-item">
            What is a VPN Kill Switch?
          </a>
          <a href="/blog/what-is-a-dns-leak/" class="sidebar-nav-item">
            What Is a DNS Leak &amp; How to Fix It
          </a>
          <a href="/blog/what-is-post-quantum-cryptography/" class="sidebar-nav-item">
            What Is Post-Quantum Cryptography?
          </a>
          <a href="/blog/what-is-a-vpn-protocol/" class="sidebar-nav-item">
            What is a VPN Protocol?
          </a>
          <a href="/blog/what-is-a-vpn-tunnel/" class="sidebar-nav-item">
            What is a VPN Tunnel?
          </a>
          <a href="/blog/what-is-a-webrtc-leak/" class="sidebar-nav-item">
            What is a WebRTC Leak?
          </a>
        </nav>
        <a href="/tags/protocol-tech/" class="sidebar-view-all-link">
          View All Protocols &rarr;
        </a>

        <!-- Minimized Promo Card -->
        <div class="sidebar-promo-card">
          <p class="sidebar-promo-text">
            Free, high-speed WireGuard VPN for public Wi-Fi security on every device.
          </p>
          <a href={SITE.marketingUrl} class="sidebar-cta-btn">
            Download OllaVPN Free &rarr;
          </a>
        </div>
      </aside>

    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
