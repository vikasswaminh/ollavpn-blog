---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';

interface Props {
  post: any;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: any[];
}

const { post, headings = [], relatedPosts = [] } = Astro.props;

const {
  title,
  description,
  pubDate,
  updatedDate,
  author = SITE.author,
  cover,
  tags = [],
  canonical = Astro.url.href,
} = post.data;

const minutes = Math.max(3, Math.ceil((post.body ? post.body.split(/\s+/).length : 1500) / 220));

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
});

const updatedFormattedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : formattedDate;

const firstTag = tags && tags[0] ? tags[0].replace(/-/g, ' ') : 'buyer guide';

const categoryMap: Record<string, string> = {
  "privacy-security": "Privacy & Security",
  "protocol-tech": "Protocols & Technology",
  "pillars": "Post-Quantum Cryptography",
  "buyer-guides": "Buyer Guides & Audits",
  "beginner-basics": "Beginner Basics",
  "how-to-guides": "How-To Guides",
  "comparisons": "Comparisons",
  "use-cases": "Use Cases"
};
const categorySlug = post.data.category || (tags && tags[0] ? tags[0] : 'protocol-tech');
const categoryName = categoryMap[categorySlug] || (firstTag.charAt(0).toUpperCase() + firstTag.slice(1));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://ollavpn.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://ollavpn.com/blog/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoryName,
      item: `https://ollavpn.com/tags/${categorySlug}/`
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: title,
      item: `https://ollavpn.com/blog/${post.slug}/`
    }
  ]
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author ?? SITE.author },
  publisher: { '@type': 'Organization', name: SITE.brand },
  mainEntityOfPage: canonical,
  ...(cover ? { image: new URL(cover, Astro.site).href } : {}),
};

// Extract FAQs from post body for Google FAQPage Schema
interface FAQItem {
  question: string;
  answer: string;
}

const body = post.body || '';
const faqs: FAQItem[] = [];

// Match accordion items: <details class="faq-accordion-item"...>
const accordionRegex = /<details[^>]*class=['"][^'"]*faq-accordion-item[^'"]*['"][^>]*>([\s\S]*?)<\/details>/gi;
let match;
while ((match = accordionRegex.exec(body)) !== null) {
  const itemContent = match[1];

  let qMatch = /<summary[^>]*>[\s\S]*?<span>([\s\S]*?)<\/span>/i.exec(itemContent);
  if (!qMatch) {
    qMatch = /<summary[^>]*>([\s\S]*?)<\/summary>/i.exec(itemContent);
  }

  let aMatch = /<p[^>]*class=['"][^'"]*faq-accordion-content[^'"]*['"][^>]*>([\s\S]*?)<\/p>/i.exec(itemContent);
  let answerText = '';
  if (aMatch) {
    answerText = aMatch[1];
  } else {
    const parts = itemContent.split(/<\/summary>/i);
    if (parts.length > 1) {
      answerText = parts[1];
    }
  }

  if (qMatch) {
    let q = qMatch[1].replace(/<[^>]+>/g, '').trim();
    q = q.replace(/\s*\+\s*$/, '').trim();
    q = q.replace(/\s+/g, ' ');

    let a = answerText.replace(/<[^>]+>/g, '').trim();
    a = a.replace(/\s+/g, ' ');

    if (q && a) {
      faqs.push({ question: q, answer: a });
    }
  }
}

// Fallback: Markdown ### question headings under FAQ
if (faqs.length === 0) {
  const faqSectionMatch = /##\s*(?:Frequently Asked Questions|FAQ|Common Questions)[\s\S]*/i.exec(body);
  if (faqSectionMatch) {
    const faqSection = faqSectionMatch[0];
    const qBlocks = faqSection.matchAll(/###\s+([^\n\r]+)[\n\r]+([\s\S]*?)(?=(?:###|\Z|##))/gi);
    for (const qBlock of qBlocks) {
      let cleanQ = qBlock[1].replace(/<[^>]+>/g, '').trim().replace(/\s+/g, ' ');
      let cleanA = qBlock[2].replace(/<[^>]+>/g, '').trim().replace(/\s+/g, ' ');
      if (cleanA.length > 20) {
        faqs.push({ question: cleanQ, answer: cleanA });
      }
    }
  }
}

const faqJsonLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
} : null;

// Filter H2 headings for Table of Contents
const tocHeadings = headings.filter(h => h.depth === 2);
---

<BaseLayout
  title={title}
  description={description}
  image={cover}
  article={{
    publishedTime: pubDate.toISOString(),
    modifiedTime: (updatedDate ?? pubDate).toISOString(),
    author: author ?? SITE.author,
    tags,
  }}
  fullWidth={true}
>
  <main class="page-container-24obs">
    <div class="layout-flex-24obs">

      <!-- LEFT SIDEBAR: Navigation -->
      <aside class="desktop-sidebar-24obs left-sidebar">
        <div class="sidebar-header-pill-wrap">
          <span class="sidebar-pill-badge">
            FEATURED GUIDES
          </span>
        </div>
        <nav class="sidebar-nav-list">
          <a href="/blog/free-vpn-for-public-wifi-security/" class="sidebar-nav-item">
            Free VPN for Public Wi-Fi Security (2026)
          </a>
          <a href="/blog/how-public-wifi-steals-passwords/" class="sidebar-nav-item">
            How Public Wi-Fi Steals Passwords
          </a>
          <a href="/blog/vpn-for-public-wifi-traveler/" class="sidebar-nav-item">
            VPN for Public Wi-Fi Traveler Guide
          </a>
          <a href="/blog/free-vpn-for-public-wifi-guide/" class="sidebar-nav-item">
            Free VPN for Public WiFi: Setup
          </a>
          <a href="/blog/vpn-for-traveling-abroad/" class="sidebar-nav-item">
            VPN for Traveling Abroad in 2026
          </a>
          <a href="/blog/can-a-vpn-stop-hackers/" class="sidebar-nav-item">
            Can a VPN Stop Hackers on Wi-Fi?
          </a>
          <a href="/blog/vpn-for-online-banking/" class="sidebar-nav-item">
            VPN for Safe Online Banking
          </a>
          <a href="/blog/free-vpn-for-iphone/" class="sidebar-nav-item">
            Best Free VPN for iPhone &amp; iOS
          </a>
          <a href="/blog/best-free-vpn-for-android/" class="sidebar-nav-item">
            Best Free VPN for Android Devices
          </a>
          <a href="/blog/best-free-vpn-for-windows/" class="sidebar-nav-item">
            Best Free VPN for Windows 11
          </a>
        </nav>
        <a href="/tags/buyer-guides/" class="sidebar-view-all-link">
          View All Guides &rarr;
        </a>
      </aside>

      <!-- CENTER MAIN CONTENT COLUMN -->
      <article class="article-center-col">

        <!-- Header: Eyebrow, H1, Subtitle -->
        <header class="article-header">
          <!-- Structural Breadcrumbs -->
          <nav class="article-breadcrumbs" aria-label="Breadcrumb">
            <ol itemscope itemtype="https://schema.org/BreadcrumbList" class="breadcrumbs-list">
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
                <a itemprop="item" href="/" class="breadcrumb-link">
                  <span itemprop="name">Home</span>
                </a>
                <meta itemprop="position" content="1" />
              </li>
              <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
                <a itemprop="item" href="/blog/" class="breadcrumb-link">
                  <span itemprop="name">Blog</span>
                </a>
                <meta itemprop="position" content="2" />
              </li>
              <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item">
                <a itemprop="item" href={`/tags/${categorySlug}/`} class="breadcrumb-link">
                  <span itemprop="name">{categoryName}</span>
                </a>
                <meta itemprop="position" content="3" />
              </li>
              <li class="breadcrumb-separator" aria-hidden="true">&rsaquo;</li>
              <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="breadcrumb-item current">
                <span itemprop="name" class="breadcrumb-current" aria-current="page">{title}</span>
                <meta itemprop="position" content="4" />
              </li>
            </ol>
          </nav>

          <div class="article-meta-row">
            <span>{firstTag.toUpperCase()}</span>
            <span>&bull;</span>
            <span>UPDATED {updatedFormattedDate.toUpperCase()}</span>
            <span>&bull;</span>
            <span>{minutes} MIN READ</span>
          </div>
          <h1 class="article-main-title">
            {title}
          </h1>
          <p class="article-main-desc">
            {description}
          </p>
        </header>

        <!-- Dynamic Table of Contents (if >= 3 H2 headings) -->
        {tocHeadings && tocHeadings.length >= 3 && (
          <nav class="article-toc-box" aria-label="Table of Contents">
            <div class="toc-header">
              <span class="toc-badge-dot"></span>
              <span class="toc-title">IN THIS GUIDE</span>
            </div>
            <ol class="toc-list">
              {tocHeadings.map((h) => (
                <li class="toc-item">
                  <a href={`#${h.slug}`} class="toc-link">
                    {h.text.replace(/^[0-9]+\.\s*/, '')}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <!-- Markdown Article Prose Slot -->
        <div class="prose">
          <slot />
        </div>

        <!-- In-Article High-Converting Free CTA Banner -->
        <section class="article-bottom-cta-banner" aria-label="Get OllaVPN Free">
          <div class="cta-banner-badge">
            <span class="cta-pulse-dot"></span>
            <span>ZERO LOGS &bull; 100% FREE NO CREDIT CARD</span>
          </div>
          <h3 class="cta-banner-title">
            Protect Your Browsing with Quantum-Proof Speed
          </h3>
          <p class="cta-banner-desc">
            Experience ultra-fast WireGuard protocols, in-tunnel DNS leak protection, and zero-compromise encryption on Windows, Android, and iOS with OllaVPN.
          </p>
          <div class="cta-banner-features">
            <span class="cta-feature-item">✓ WireGuard &amp; PQC</span>
            <span class="cta-feature-item">✓ No Email Required</span>
            <span class="cta-feature-item">✓ Unlimited Free Access</span>
          </div>
          <div class="cta-btn-wrap">
            <a href="/dl/" class="cta-banner-btn">
              Download OllaVPN Free &rarr;
            </a>
          </div>
        </section>

        <!-- ============================================ -->
        <!-- RELATED BLOGS: Topic Clustering Section     -->
        <!-- ============================================ -->
        {relatedPosts && relatedPosts.length > 0 && (
          <section class="related-cluster-section" id="related-articles" aria-label="Related Articles in this Topic Cluster">
            <div class="related-cluster-header">
              <div class="related-cluster-pill">
                <span class="related-pill-dot"></span>
                <span>TOPIC CLUSTER DEEP DIVES</span>
              </div>
              <h2 class="related-cluster-title">Related Technical Guides</h2>
              <p class="related-cluster-desc">
                Continue reading related cybersecurity benchmarks, protocol analyses, and security guides clustered by topic.
              </p>
            </div>

            <div class="related-cluster-grid">
              {relatedPosts.slice(0, 3).map((item: any) => {
                const itemData = item.data || item;
                const itemSlug = item.slug || (itemData.slug || '');
                const itemTitle = itemData.title || '';
                const itemDesc = itemData.description || '';
                const itemTags = itemData.tags || [];
                const itemTag = itemTags[0] ? itemTags[0].replace(/-/g, ' ') : 'Cybersecurity';
                const itemMinutes = Math.max(3, Math.ceil((item.body ? item.body.split(/\s+/).length : 1200) / 220));

                return (
                  <article class="related-card-clean">
                    <a href={`/blog/${itemSlug}/`} class="related-card-link-wrapper" aria-label={itemTitle}>
                      <div class="related-card-badge-row">
                        <span class="related-card-tag">{itemTag}</span>
                        <span class="related-card-time">{itemMinutes} min read</span>
                      </div>
                      <h3 class="related-card-title">{itemTitle}</h3>
                      <p class="related-card-excerpt">{itemDesc}</p>
                      <div class="related-card-footer">
                        <span class="related-card-author">OllaVPN Lab</span>
                        <span class="related-card-arrow">Read Guide &rarr;</span>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          </section>
        )}

      </article>

      <!-- RIGHT SIDEBAR: Navigation + Minimized Promo Card -->
      <aside class="desktop-sidebar-24obs right-sidebar">
        <div class="sidebar-header-pill-wrap">
          <span class="sidebar-pill-badge">
            VPN PROTOCOLS &amp; TECH
          </span>
        </div>
        <nav class="sidebar-nav-list">
          <a href="/blog/wireguard-vs-openvpn/" class="sidebar-nav-item">
            WireGuard vs. OpenVPN Comparison
          </a>
          <a href="/blog/wireguard-vs-ikev2/" class="sidebar-nav-item">
            WireGuard vs IKEv2: Speed &amp; Latency
          </a>
          <a href="/blog/what-is-a-vpn-kill-switch/" class="sidebar-nav-item">
            What is a VPN Kill Switch?
          </a>
          <a href="/blog/what-is-a-dns-leak/" class="sidebar-nav-item">
            What Is a DNS Leak &amp; How to Fix It
          </a>
          <a href="/blog/what-is-post-quantum-cryptography/" class="sidebar-nav-item">
            What Is Post-Quantum Cryptography?
          </a>
          <a href="/blog/what-is-a-vpn-protocol/" class="sidebar-nav-item">
            What is a VPN Protocol?
          </a>
          <a href="/blog/what-is-a-vpn-tunnel/" class="sidebar-nav-item">
            What is a VPN Tunnel?
          </a>
          <a href="/blog/what-is-a-webrtc-leak/" class="sidebar-nav-item">
            What is a WebRTC Leak?
          </a>
        </nav>
        <a href="/tags/protocol-tech/" class="sidebar-view-all-link">
          View All Protocols &rarr;
        </a>

        <!-- Minimized Promo Card -->
        <div class="sidebar-promo-card">
          <p class="sidebar-promo-text">
            Free, high-speed WireGuard VPN for public Wi-Fi security on every device.
          </p>
          <a href="/dl/" class="sidebar-cta-btn">
            Download OllaVPN Free &rarr;
          </a>
        </div>
      </aside>

    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  )}
</BaseLayout>

<style>
  /* Table of Contents Styling */
  .article-toc-box {
    margin: 28px 0 36px 0;
    padding: 20px 24px;
    background: #0d0f12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 3px solid #DA291C;
    border-radius: 8px;
  }
  .toc-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .toc-badge-dot {
    width: 7px;
    height: 7px;
    background: #DA291C;
    border-radius: 50%;
  }
  .toc-title {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #DA291C;
  }
  .toc-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .toc-item {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.45;
  }
  .toc-link {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .toc-link:hover {
    color: #DA291C;
    text-decoration: underline;
  }

  /* In-Article Bottom CTA Banner */
  .article-bottom-cta-banner {
    margin: 48px 0 40px 0;
    padding: 32px 28px;
    background: linear-gradient(145deg, #11141a 0%, #090b0e 100%);
    border: 1px solid rgba(218, 41, 28, 0.25);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    text-align: center;
  }
  .cta-banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(218, 41, 28, 0.12);
    border: 1px solid rgba(218, 41, 28, 0.3);
    color: #ff5242;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 14px;
  }
  .cta-pulse-dot {
    width: 6px;
    height: 6px;
    background: #ff5242;
    border-radius: 50%;
  }
  .cta-banner-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px 0;
    line-height: 1.3;
  }
  .cta-banner-desc {
    font-size: 0.98rem;
    color: #94a3b8;
    max-width: 620px;
    margin: 0 auto 20px auto;
    line-height: 1.55;
  }
  .cta-banner-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .cta-feature-item {
    font-size: 0.88rem;
    font-weight: 600;
    color: #cbd5e1;
  }
  .cta-btn-wrap {
    display: flex;
    justify-content: center;
  }
  .cta-banner-btn {
    display: inline-block;
    background: #DA291C;
    color: #ffffff !important;
    font-weight: 700;
    font-size: 1rem;
    padding: 12px 28px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .cta-banner-btn:hover {
    background: #b52216;
    transform: translateY(-1px);
  }
</style>
